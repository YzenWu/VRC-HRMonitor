    "interval_ms": "1000",
    "receive_port": "9001",
    "auto_start": false,
    "template": "HeartBeat {BPM0} BPM\nCPU: {CPU_PRODUCT_NAME} {CPU_USAGE}%\nGPU: {GPU_PRODUCT_NAME0}\nVRAM: {VRAM_USED0} of {VRAM_TOTAL0}\nRAM: {RAM_USED} / {RAM_TOTAL}\nFocus: {FOCUS_WINDOW_TITLE}"
