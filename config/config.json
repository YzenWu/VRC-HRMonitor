      "visible": false,
      "locked": false,
      "geometry": "200x80+100+100",
      "unlocked_color": "#00FF00",
      "locked_color": "#FF6600",
      "format": "❤️{bpm}",
      "image_path": null,
      "source": "平均",
      "refresh_ms": 200,
      "sources": {}
    }
  },
  "webhook": {
    "enabled": false
  },
  "logs": {
    "auto_dump_enabled": true,
    "auto_dump_interval_min": "30",
    "dump_dir": "logs/auto"
